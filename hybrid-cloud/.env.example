# mapleads-hybrid — placeholders only. Do not add real values to this file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Desktop-only secret: generate at least 32 random characters per device.
# Never commit it, send it through chat, or put it in a browser bundle.
MAPLEADS_DEVICE_ID=00000000-0000-0000-0000-000000000000
MAPLEADS_DEVICE_TOKEN=REPLACE_WITH_A_UNIQUE_DEVICE_TOKEN

# Future server/Edge-only value. It is deliberately not for the desktop app.
SUPABASE_SERVICE_ROLE_KEY=SERVER_OR_EDGE_ONLY_NEVER_DESKTOP
