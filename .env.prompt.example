# Prompt SYSTEM de la IA
#
# Default (recomendado): compact — hechos consolidados + conocimiento del turno,
# sin catálogo ni bloques repetidos.
#
# ROLLBACK si algo falla (vuelve al prompt largo anterior):
#   AI_PROMPT_MODE=legacy
# o:
#   AI_COMPACT_PROMPT=false
#
# Luego redeploy / reinicia el runtime (Netlify env vars).
AI_PROMPT_MODE=compact
# AI_COMPACT_PROMPT=true

# Web Push PWA tienda (generar con: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com
